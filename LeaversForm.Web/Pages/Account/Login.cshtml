@page
@model LeaversForm.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="card form-card login-card">
    <div class="login-brand">
        <img src="~/images/yours-logo.png" alt="Yours Clothing" class="login-logo" asp-append-version="true" />
        <h1>Leavers Form</h1>
        <p class="muted">Sign in with your Yours Clothing Microsoft account to continue.</p>
    </div>
    <p class="muted">Redirecting to Microsoft sign-in…</p>
</div>
